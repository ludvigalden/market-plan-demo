root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,ts,tsx,json,yaml,yml,css,html}]
indent_size = 2

[*.{hcl,tf}]
indent_size = 2

[*.sh]
indent_size = 2

[*.{md,markdown}]
indent_size = unset
trim_trailing_whitespace = false
